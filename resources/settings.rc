#pragma code_page(65001)

// Keep this resource self-contained. Some Rust-only Windows toolchains provide
// rc.exe without configuring the Windows SDK include directory for windows.h.
#define DS_SETFONT        0x0040L
#define DS_MODALFRAME     0x0080L
#define DS_CENTER         0x0800L
#define WS_POPUP          0x80000000L
#define WS_CAPTION        0x00C00000L
#define WS_SYSMENU        0x00080000L
#define WS_TABSTOP        0x00010000L
#define WS_VSCROLL        0x00200000L
#define WS_EX_APPWINDOW   0x00040000L
#define ES_AUTOHSCROLL    0x0080L
#define ES_READONLY       0x0800L
#define ES_NUMBER         0x2000L
#define CBS_DROPDOWNLIST  0x0003L
#define BS_AUTOCHECKBOX   0x0003L
#define IDOK              1
#define IDCANCEL          2

#define IDD_SETTINGS             101
#define IDC_FULLSCREEN_SHORTCUT  1001
#define IDC_REGION_SHORTCUT      1002
#define IDC_AUTOSAVE_DIRECTORY   1003
#define IDC_BROWSE_DIRECTORY     1004
#define IDC_IMAGE_FORMAT         1005
#define IDC_JPEG_QUALITY         1006
#define IDC_PNG_COMPRESSION      1007
#define IDC_MONITOR_SCOPE        1008
#define IDC_INCLUDE_CURSOR       1009
#define IDC_RESTORE_DEFAULTS     1010
#define IDC_SETTINGS_STATUS      1011
#define IDC_JPEG_QUALITY_LABEL   1012
#define IDC_PNG_COMPRESSION_LABEL 1013
#define IDC_PNG_HELP             1014
#define IDC_REGION_AUTO_COPY     1015
#define IDC_REGION_AUTOSAVE      1016

IDD_SETTINGS DIALOGEX 0, 0, 430, 335
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Настройки Rustshot"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX        "Горячие клавиши", -1, 8, 7, 414, 77
    LTEXT           "Снимок всего &экрана:", -1, 18, 24, 102, 10
    EDITTEXT        IDC_FULLSCREEN_SHORTCUT, 126, 21, 282, 14, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    LTEXT           "Выбор &области:", -1, 18, 48, 102, 10
    EDITTEXT        IDC_REGION_SHORTCUT, 126, 45, 282, 14, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    LTEXT           "Зажмите сочетание, например Ctrl+Shift+Backspace, и отпустите. Tab — далее.", -1, 126, 66, 282, 10

    GROUPBOX        "Сохранение и качество", -1, 8, 90, 414, 113
    LTEXT           "&Папка автосохранения:", -1, 18, 108, 102, 10
    EDITTEXT        IDC_AUTOSAVE_DIRECTORY, 126, 105, 221, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "О&бзор...", IDC_BROWSE_DIRECTORY, 353, 104, 55, 16, WS_TABSTOP
    LTEXT           "&Формат изображения:", -1, 18, 132, 102, 10
    COMBOBOX        IDC_IMAGE_FORMAT, 126, 129, 104, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Качество &JPEG (1–100):", IDC_JPEG_QUALITY_LABEL, 245, 132, 104, 10
    EDITTEXT        IDC_JPEG_QUALITY, 353, 129, 55, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Сжатие &PNG:", IDC_PNG_COMPRESSION_LABEL, 18, 158, 102, 10
    COMBOBOX        IDC_PNG_COMPRESSION, 126, 155, 104, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "PNG сохраняет без потерь: сжатие влияет на скорость и размер файла.", IDC_PNG_HELP, 126, 181, 282, 10

    GROUPBOX        "Снимок", -1, 8, 209, 414, 88
    LTEXT           "&Весь экран — это:", -1, 18, 228, 102, 10
    COMBOBOX        IDC_MONITOR_SCOPE, 126, 225, 143, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Показывать &курсор мыши", IDC_INCLUDE_CURSOR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 285, 226, 123, 12
    CONTROL         "Сразу &копировать выделенную область", IDC_REGION_AUTO_COPY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 252, 190, 12
    CONTROL         "Сразу &сохранять выделенную область", IDC_REGION_AUTOSAVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 218, 252, 190, 12
    LTEXT           "С любым из этих действий снимок завершается сразу после выделения, без редактора.", -1, 18, 277, 390, 10

    PUSHBUTTON      "По &умолчанию", IDC_RESTORE_DEFAULTS, 8, 309, 82, 18, WS_TABSTOP
    LTEXT           "", IDC_SETTINGS_STATUS, 99, 313, 188, 10
    DEFPUSHBUTTON   "Со&хранить", IDOK, 297, 309, 58, 18, WS_TABSTOP
    PUSHBUTTON      "Отмена", IDCANCEL, 364, 309, 58, 18, WS_TABSTOP
END
